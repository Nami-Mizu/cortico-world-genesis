{
  "name": "cortico-world-genesis",
  "version": "3.5.2",
  "type": "module",
  "description": "给 Agent 一颗物理自洽、一次性创世的星球：种子与少量旋钮生成恒星系与行星属性。",
  "license": "MIT",
  "author": "Nami-Mizu (涟想时雨)",
  "contributors": [
    {
      "name": "DeepSeek",
      "url": "https://www.deepseek.com"
    }
  ],
  "keywords": [
    "cortico-world",
    "cortico",
    "world",
    "planet",
    "astronomy",
    "procedural-generation"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "创世记",
    "tags": [
      "experimental"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webui.json --noEmit",
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --target=es2022 --platform=browser --outfile=dist/webui.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.13",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "displayName": "栖星 · 创世记"
}
